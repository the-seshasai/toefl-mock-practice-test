# LLM: local Claude Code (`claude -p`). No API key needed; run `claude` once to log in.
CLAUDE_PATH=claude
# haiku (fast, light on usage) | sonnet | leave empty for Claude Code's default
CLAUDE_MODEL=
LLM_MIN_INTERVAL_SECONDS=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120

# Allowed browser origin for CORS (the Vite dev server proxies /api, so this rarely matters)
FRONTEND_ORIGIN=http://localhost:5173

# Local data: sqlite db, generated audio, your recordings
# DATA_DIR defaults to <repo>/data regardless of where you start the server
# DATA_DIR=/absolute/path/to/data

# Speech
WHISPER_MODEL=base.en
# WHISPER_DIR defaults to <repo>/data/whisper (model folder: <WHISPER_DIR>/<WHISPER_MODEL>)
# PIPER_VOICE_DIR defaults to <repo>/data/piper
