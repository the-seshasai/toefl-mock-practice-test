# LLM provider: gemini (default) | claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional second provider
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Ports (8000 is taken on this machine)
BACKEND_PORT=8001
FRONTEND_ORIGIN=http://localhost:5173

# Local data (sqlite db, audio cache)
DATA_DIR=./data

# Speech
WHISPER_MODEL=base
PIPER_VOICE_DIR=./data/piper
